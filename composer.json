{
    "name": "beedelivery/bee-maps",
    "description": "SDK Laravel multi-provider de geolocalizacao (Google Maps, HERE)",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": { "BeeDelivery\\BeeMaps\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "BeeDelivery\\BeeMaps\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": [ "BeeDelivery\\BeeMaps\\BeeMapsServiceProvider" ]
        }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
