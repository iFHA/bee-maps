{
    "name": "beedelivery/bee-maps",
    "description": "SDK Laravel multi-provider de geolocalizacao (Google Maps, HERE)",
    "keywords": [
        "geolocation",
        "maps",
        "google-maps",
        "here",
        "geocoding",
        "autocomplete",
        "laravel"
    ],
    "license": "MIT",
    "homepage": "https://github.com/bee-delivery/bee-maps",
    "support": {
        "issues": "https://github.com/bee-delivery/bee-maps/issues"
    },
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "suggest": {
        "google/apiclient": "Necessario apenas para a estrategia fleet_routing de RouteOptimization (OAuth de service account). A estrategia default, matrix_tsp, nao precisa dela."
    },
    "autoload": {
        "psr-4": { "BeeDelivery\\BeeMaps\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "BeeDelivery\\BeeMaps\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": [ "BeeDelivery\\BeeMaps\\BeeMapsServiceProvider" ],
            "aliases": { "BeeMaps": "BeeDelivery\\BeeMaps\\Facades\\BeeMaps" }
        }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
